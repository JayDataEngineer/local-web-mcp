# MCP Server Configuration

# SECURITY: Generate strong passwords for production
# Example: openssl rand -base64 32

# Tailscale Auth Key (get from https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=tskey-auth-replace-with-your-key-here

# Tailscale MagicDNS Configuration
# Find your tailnet domain at: https://login.tailscale.com/admin/dns
# Example: If your tailnet is "example.ts.net" and machine is "mcp-server"
#          TAILNET_DOMAIN=example.ts.net
#          TAILNET_MACHINE_NAME=mcp-server
# Full URL would be: https://mcp-server.example.ts.net
TAILNET_DOMAIN=your-tailnet.ts.net
TAILNET_MACHINE_NAME=mcp-server

# SearXNG Secret (generate with: openssl rand -hex 32)
SEARXNG_SECRET=

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mcp_server
POSTGRES_USER=postgres
# WARNING: Change this password for production!
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=postgres

# External Services
SEARXNG_URL=http://searxng:8080

# Celery Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API Settings
MCP_HOST=0.0.0.0
MCP_PORT=8000

# CORS Allowed Origins (comma-separated)
# For Tailscale/localhost: http://localhost:8000,http://127.0.0.1:8000
# To allow all (NOT recommended for public): *
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# =============================================================================
# VPN / Proxy Configuration (Gluetun + Proton VPN)
# =============================================================================
#
# All search and scrape traffic routes through a SOCKS5 proxy provided by
# Gluetun, which tunnels through Proton VPN via WireGuard. Your real IP never
# touches any site you scrape.
#
# SETUP: Getting your Proton WireGuard credentials
#
#   1. Log into https://account.protonvpn.com/downloads
#   2. Click "WireGuard configuration"
#   3. Select a free or paid server (e.g. US-Free#1, or any server)
#   4. Download the .conf file — it looks like this:
#
#      [Interface]
#      PrivateKey = abc123...
#      Address = 10.2.0.2/32
#      DNS = 10.2.0.1
#
#      [Peer]
#      PublicKey = xyz789...
#      Endpoint = 1.2.3.4:51820
#      AllowedIPs = 0.0.0.0/0
#
#   5. Copy each value into the variables below
#

# Required: WireGuard credentials from your VPN provider config file
WIREGUARD_PRIVATE_KEY=          # [Interface] PrivateKey
WIREGUARD_ADDRESS=10.2.0.2/32   # [Interface] Address
WIREGUARD_PUBLIC_KEY=           # [Peer] PublicKey
WIREGUARD_ENDPOINT_IP=          # [Peer] Endpoint IP (e.g. 1.2.3.4)
WIREGUARD_ENDPOINT_PORT=51820   # [Peer] Endpoint port

# Optional: Country filter (e.g. "US", "NL", "JP")
# VPN_COUNTRY=

# =============================================================================
# Advanced Proxy Configuration
# =============================================================================
# These are set automatically by docker-compose when using Gluetun.
# Only change these if you want to use a different proxy provider.

# MCP_PROXY_URL=http://gluetun:8888     # Default: Gluetun HTTP proxy
# MCP_PROXY_URLS=                         # Multiple proxies for rotation (comma-separated)
# MCP_PROXY_ROTATION=round-robin          # "round-robin" or "random"
# MCP_PROXY_EXCLUDE=searxng,postgres,redis,localhost,127.0.0.1  # Internal services to bypass
